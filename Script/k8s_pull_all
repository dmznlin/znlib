#!/bin/bash
# 作用：批量拉取Docker镜像并导入K8s（containerd环境）
# 参数：$1 = n 时只拉取,不执行导入

# ====================== 批量导入配置 ======================
# 1. 校验参数
K8S_import="y"
if [ $# -ge 1 ]; then
    K8S_import="$1"
fi

# 2. 镜像列表（一行一个，支持别名：别名=实际镜像名）
IMAGE_LIST=(
	"easzlab.io.local:5000/rancher/local-path-provisioner:v0.0.36=docker.runsoft.online:5000/docker.io/local-path-provisioner:v0.0.36"
	"easzlab.io.local:5000/easzlab/nfs-subdir-external-provisioner:v4.0.2=docker.runsoft.online:5000/easzlab/nfs-subdir-external-provisioner:v4.0.2"
	"easzlab.io.local:5000/kubernetesui/dashboard-api:1.14.0=docker.runsoft.online:5000/easzlab/dashboard-api:1.14.0"
	"easzlab.io.local:5000/kubernetesui/dashboard-auth:1.4.0=docker.runsoft.online:5000/easzlab/dashboard-auth:1.4.0"
	"easzlab.io.local:5000/kubernetesui/dashboard-metrics-scraper:1.2.2=docker.runsoft.online:5000/easzlab/dashboard-metrics-scraper:1.2.2"
	"easzlab.io.local:5000/kubernetesui/dashboard-web:1.7.0=docker.runsoft.online:5000/easzlab/dashboard-web:1.7.0"
	"easzlab.io.local:5000/kubernetesui/kong:3.9=docker.runsoft.online:5000/docker.io/kong:3.9.1"
	"easzlab.io.local:5000/easzlab/kube-state-metrics:v2.16.0=docker.runsoft.online:5000/easzlab/kube-state-metrics:v2.16.0"
	"easzlab.io.local:5000/easzlab/kube-webhook-certgen:v1.6.0=docker.runsoft.online:5000/easzlab/kube-webhook-certgen:v1.6.0"
	"easzlab.io.local:5000/prometheus/grafana:12.0.2"
	"easzlab.io.local:5000/prometheus/k8s-sidecar:1.30.5"
	"easzlab.io.local:5000/prometheus/prometheus-config-reloader:v0.83.0"
	"easzlab.io.local:5000/prometheus/prometheus-operator:v0.83.0"
	"easzlab.io.local:5000/prometheus/alertmanager:v0.28.1"
	"easzlab.io.local:5000/prometheus/node-exporter:v1.9.1"
	"easzlab.io.local:5000/prometheus/prometheus:v3.4.2"
    # 继续添加更多镜像...
)

# 3. 单个镜像处理脚本的路径（和本脚本同目录就不用改）
SINGLE_SCRIPT="./k8s_pull"
# ==========================================================

# 检查单个脚本是否存在
if [ ! -f "$SINGLE_SCRIPT" ]; then
    echo -e "\033[31m错误：找不到单个镜像处理脚本 $SINGLE_SCRIPT\033[0m"
    exit 1
fi

echo -e "\033[32m==================================================\033[0m"
echo -e "\033[32m          批量镜像导入任务开始\033[0m"
echo -e "\033[32m==================================================\033[0m"
echo "待导入镜像总数：${#IMAGE_LIST[@]}"
echo -e "\033[32m==================================================\033[0m"

# 循环导入每个镜像
SUCCESS_COUNT=0
FAIL_COUNT=0

for IMAGE in "${IMAGE_LIST[@]}"; do
    # 跳过空行
    if [ -z "$IMAGE" ]; then
        continue
    fi

    echo -e "\n\033[34m====== 正在处理镜像：$IMAGE ======\033[0m"

    # 执行单个导入脚本
    $SINGLE_SCRIPT "$IMAGE" "$K8S_import"

    # 获取执行结果
    if [ $? -eq 0 ]; then
        echo -e "\033[32m✅ 镜像 $IMAGE 处理成功\033[0m"
        SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
    else
        echo -e "\033[31m❌ 镜像 $IMAGE 处理失败\033[0m"
        FAIL_COUNT=$((FAIL_COUNT + 1))
    fi
done

# 最终统计
echo -e "\n\033[32m==================================================\033[0m"
echo -e "\033[32m                    任务结束\033[0m"
echo -e "\033[32m==================================================\033[0m"
echo "成功：$SUCCESS_COUNT 个"
echo "失败：$FAIL_COUNT 个"
echo -e "\033[32m==================================================\033[0m"

# 有失败则退出码为1
if [ $FAIL_COUNT -gt 0 ]; then
    exit 1
else
    exit 0
fi