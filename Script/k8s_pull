#!/bin/bash
# 作用：拉取Docker镜像并导入K8s（containerd环境）
# 参数：$1 = 完整镜像名称（如 nginx:latest）

# ====================== 配置区 ======================
TMP_DIR="/tmp/k8s_images"
# ====================================================

# 1. 校验参数
if [ $# -lt 1 ]; then
    echo "【错误】请传入参数：完整镜像名称 是否导入k8s,默认导入"
    echo "【用法】bash $0 <镜像名称:标签> y/n"
    echo "【示例】bash $0 nginx:latest"
    exit 1
fi

IMAGE_NAME="$1"

# 2. 创建临时目录
mkdir -p "${TMP_DIR}"
TAR_FILE="${TMP_DIR}/$(echo ${IMAGE_NAME} | tr '/' '-').tar"

# 3. 检查本地Docker镜像，存在则跳过拉取
echo "========================================"
echo "【检查】本地 Docker 镜像：${IMAGE_NAME}"
if docker image inspect "${IMAGE_NAME}" > /dev/null 2>&1; then
    echo "【跳过】本地已存在，无需拉取"
else
    echo "【拉取】开始拉取镜像..."
    # 构造私有仓库镜像名
    PRIVATE_IMAGE="docker.runsoft.online:5000/docker.io/${IMAGE_NAME##*/}"

    # 尝试从私有仓库拉取镜像
    if docker pull "$PRIVATE_IMAGE" 2>/dev/null; then
        echo "从私有仓库拉取成功: $PRIVATE_IMAGE"

        # 使用 tag 去掉私有仓库地址，保留原镜像名
        docker tag "$PRIVATE_IMAGE" "$IMAGE_NAME"
        echo "已标记为本地镜像: $IMAGE_NAME"

        # 删除带私有仓库前缀的镜像
        docker rmi "$PRIVATE_IMAGE" || true
    fi

    if ! docker image inspect "${IMAGE_NAME}" > /dev/null 2>&1; then
        docker pull "${IMAGE_NAME}"
        if [ $? -ne 0 ]; then
		    echo "【错误】拉取失败！"
		    rm -f "${TAR_FILE}"
		    exit 1
        fi

        docker tag "${IMAGE_NAME}" "$PRIVATE_IMAGE" && \
		docker push "$PRIVATE_IMAGE" && \
        docker rmi "$PRIVATE_IMAGE"
    fi

    echo "【成功】拉取完成"
fi

if [ "$2" = "n" ]; then
    echo "【完成】跳过导出操作！"
    exit 0
fi

# 4. 导出镜像
echo "========================================"
echo "【导出】保存为 tar 包"
docker save -o "${TAR_FILE}" "${IMAGE_NAME}"
if [ $? -ne 0 ]; then
    echo "【错误】导出失败！"
    rm -f "${TAR_FILE}"
    exit 1
fi

# 5. 导入 containerd (k8s.io 命名空间)
echo "========================================"
echo "【导入】导入到 K8s containerd 镜像库"
ctr -n k8s.io images import "${TAR_FILE}"
if [ $? -ne 0 ]; then
    echo "【错误】导入失败！"
    rm -f "${TAR_FILE}"
    exit 1
fi
echo "【成功】镜像导入 K8s 完成"

# 6. 清理临时文件
echo "========================================"
echo "【清理】删除临时文件"
rm -f "${TAR_FILE}"
rmdir "${TMP_DIR}" 2>/dev/null

# 7. 验证结果
echo "========================================"
echo "【验证】K8s  containerd 中的镜像："
ctr -n k8s.io images ls | grep "${IMAGE_NAME}"
echo "========================================"
echo "【全部完成】操作成功！"